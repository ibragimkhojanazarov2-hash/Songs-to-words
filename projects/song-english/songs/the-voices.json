  },
  {
   "start": 17.21,
   "end": 22.36,
   "text": "Oh Voices never speak, and all night"
  },
  {
   "start": 23.58,
   "end": 27.0,
   "text": "Now they're in the corner, out of sight"
  },
  {
   "start": 27.02,
   "end": 30.58,
   "text": "And oh, they're on the fleeting little whispers"
  },
  {
   "start": 30.66,
   "end": 32.94,
   "text": "And the creeping little shivers And they're sleeping"
  },
  {
   "start": 32.94,
   "end": 37.7,
   "text": "till the sun burns out Then they're gonna"
  },
  {
   "start": 37.7,
   "end": 40.68,
   "text": "scream and shout"
  },
  {
   "start": 40.68,
   "end": 55.01,
   "text": "♪"
  },
  {
   "start": 55.01,
   "end": 60.29,
   "text": "Hold your breath and count to ten"
  },
  {
   "start": 60.63,
   "end": 65.12,
   "text": "Remember that it's all in your head If"
  },
  {
   "start": 65.12,
   "end": 68.18,
   "text": "you let them in, they'll breed and spread,"
  },
  {
   "start": 68.18,
   "end": 71.78,
   "text": "and oh Gotta take them, gotta break them,"
  },
  {
   "start": 71.78,
   "end": 74.18,
   "text": "gotta shake them, gotta make them Even stutter"
  },
  {
   "start": 74.18,
   "end": 79.57,
   "text": "till they're all burned out You gotta drive"
  },
  {
   "start": 79.57,
   "end": 81.55,
   "text": "them out"
  },
  {
   "start": 81.55,
   "end": 167.92,
   "text": "♪"
  },
  {
   "start": 167.92,
   "end": 168.4,
   "text": "We'll be right back."
  }
